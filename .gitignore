# ============================================================
# WebSentry AI — Root .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Node Modules ---
node_modules/
frontend/node_modules/
backend/node_modules/

# --- Build Outputs ---
frontend/dist/
frontend/build/

# --- Playwright ---
backend/public/screenshots/
test-results/
playwright-report/
playwright/.cache/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / Editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/

# --- Scratch / Test Artifacts ---
scratch/
*.test-output.*

# --- Coverage ---
coverage/

# --- Misc ---
*.tgz
*.zip
